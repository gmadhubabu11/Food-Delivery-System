# Copy to .env and edit. Never commit the real .env
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/food_delivery
JWT_SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local timezone offset in minutes used for opening hours / peak hours (330 = IST)
TZ_OFFSET_MINUTES=330

# Set to false to disable APScheduler jobs (e.g. in tests)
SCHEDULER_ENABLED=true

# Bonus: multiply delivery fee by 1.5 during 12-14 and 19-22
SURGE_PRICING_ENABLED=false

# Used by `python -m app.utils.seed`
ADMIN_EMAIL=admin@food.com
ADMIN_PASSWORD=Admin@123
